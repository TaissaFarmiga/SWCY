{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "1.10.28",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate-icons": "npx @capacitor/assets generate --android",
    "release": "node scripts/deploy-github.cjs",
    "build:android:forward-rollback": "node scripts/build-forward-rollback.cjs",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "node scripts/run-business-tests.mjs",
    "test:full:10": "node scripts/run-full-verification-rounds.cjs",
    "test:android:all:5": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-smoke-rounds.ps1 -Rounds 5 -Mode all",
    "validate:business": "node scripts/run-business-tests.mjs",
    "validate:store:code": "node scripts/validate-store-readiness.mjs --code-only",
    "validate:store": "node scripts/validate-store-readiness.mjs",
    "audit:android:store": "node scripts/audit-store-manifest.mjs storeDebug",
    "build:android": "npm run build && npx cap sync android",
    "build:android:enterprise": "npm run build:android && cd android && gradlew.bat assembleEnterpriseRelease --no-daemon --console=plain",
    "build:android:store": "npm run build:android && cd android && gradlew.bat bundleStoreRelease --no-daemon --console=plain",
    "build:android:store:debug": "npm run build:android && cd android && gradlew.bat bundleStoreDebug --no-daemon --console=plain && cd .. && node scripts/audit-store-manifest.mjs storeDebug",
    "test:android:compile": "cd android && gradlew.bat assembleSmokeDebug assembleSmokeDebugAndroidTest --no-daemon --console=plain",
    "test:android:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-smoke.ps1 -Mode smoke",
    "test:android:screenshots": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-smoke.ps1 -Mode screenshots",
    "test:android:stress": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-smoke.ps1 -Mode stress"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/dialog": "^8.0.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@supabase/supabase-js": "^2.57.4",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "exceljs": {
      "archiver": "8.0.0",
      "unzipper": "0.12.3",
      "uuid": "11.1.1"
    }
  }
}
